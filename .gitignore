# Environment variables
.env
.env.local
.env.*

# Secrets and credentials
client_secret.json
client_secrets.json
token.pickle
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Media and Storage
storage/*
!storage/*.json
media/*.mp4
media/*.mp3
media/*.jpg
media/*.png

# Automation storage — exclude all generated/temp files, keep only JSON state
automation/storage/temp_images/
automation/storage/temp_videos/
automation/storage/thumbnails/
automation/storage/*.mp4
automation/storage/*.mp3
automation/storage/*.srt
automation/storage/*.jpg
automation/storage/*.png

# Block all audio/video by default but allow music folder
*.mp3
*.mp4
!music/*.mp3
!music/*.wav
!automation/musics/**/*.mp3
!automation/musics/**/*.wav
!automation/music/**/*.mp3
!automation/media/assets/*.mp4
!automation/media/assets/*.png
*.log

# IDEs
.vscode/
.idea/
*.swp
*.swo
